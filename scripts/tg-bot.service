[Unit]
Description=Telegram Stock Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Darwin-claude-code
ExecStart=/usr/bin/python3 /root/Darwin-claude-code/scripts/tg-bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
